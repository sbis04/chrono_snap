rules_version = '2';

// Room lifecycle, scoring and answers are owned by Cloud Functions (Admin SDK
// bypasses these rules). Clients may only: read rooms they know the code of,
// join as a player, rename themselves, and submit a guess before the deadline.
service cloud.firestore {
  match /databases/{database}/documents {

    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    match /rooms/{code} {
      allow get: if request.auth != null;
      allow list, write: if false;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt', 'lockedRound'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.score == 0
          && request.resource.data.lockedRound == -1
          && request.resource.data.joinedAt == request.time
          && room(code).status != 'finished';
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20;
        allow delete: if false;
      }

      // Guesses are private until the reveal: a player can only see their own.
      // Doc id = "{round}_{uid}".
      match /guesses/{guessId} {
        allow get: if request.auth != null && guessId.split('_')[1] == request.auth.uid;
        allow list: if false;
        allow create, update: if request.auth != null
          && guessId == string(request.resource.data.round) + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'round', 'year', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.year is int
          && request.resource.data.year >= 1880
          && request.resource.data.year <= 2100
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid))
          && room(code).status == 'guessing'
          && room(code).currentRound == request.resource.data.round
          && request.time < room(code).roundEndsAt;
        allow delete: if false;
      }

      // Per-round reveal payloads, written by functions only.
      match /results/{round} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
